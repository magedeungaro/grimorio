{
  "name": "Grimório",
  "short_name": "Grimório",
  "description": "Leitor de PDF com caneta, 100% local.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#211836",
  "theme_color": "#211836",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
